# MealMate runs fully offline in guest mode with no keys at all — everything is
# saved in the browser. Add the two Supabase values below to turn on Google
# sign-in and per-account cloud storage (see README → "Accounts & cloud sync").

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# To connect a real AI planning backend later, add a provider key here and
# implement MealPlannerService (src/lib/services/meal-planner-service.ts).
# Keep it server-side; never expose it with a NEXT_PUBLIC_ prefix.
# ANTHROPIC_API_KEY=
